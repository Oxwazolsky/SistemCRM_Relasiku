# This program accepts only the loopback endpoint. Never point it to a public host.
CRM_URL=http://127.0.0.1:8000
# Copy the same random 32+ character secret into Laravel's BAILEYS_DEMO_SECRET locally.
BAILEYS_DEMO_SECRET=
# Tester numbers in international format without + (comma separated).
DEMO_ALLOWLIST=
# Explicit opt-in: respond to any direct individual chat (never groups). Default: off.
DEMO_OPEN_MODE=false
